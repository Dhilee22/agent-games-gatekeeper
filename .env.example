# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# All values come from the Agent Games dashboard after registration:
# https://agentgames.zkverify.io/dashboard

# Port the server listens on (hosting platforms inject PORT themselves).
PORT=8080

# TODO: paste the per-agent secret from the dashboard ("Rotate Secret").
# REQUIRED before going live. Without it, inbound HMAC verification is
# disabled and the platform's preflight will fail.
AGENT_GAMES_HMAC_SECRET=

# HMAC encoding: hex (default) or sha256= .
# TODO: confirm against the dashboard preflight; switch if it rejects.
AGENT_GAMES_HMAC_FORMAT=hex

# How the envelope task_id string maps to a circuit field element.
# keccak (default), numeric, or hex.
# TODO: confirm against a practice task; keccak is what the published
# verified implementations use and what practice tasks accepted.
GATEKEEPER_TASK_ID_MODE=keccak

# Where the proof_tx seen-set + response cache are persisted on disk
# (so a restart does not forget which proofs were already used).
STATE_FILE=./state.json
